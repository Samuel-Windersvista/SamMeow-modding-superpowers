<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Shared 只放两端共享的纯数据/常量，不引用 SPT 或 BepInEx。
      目标框架用 netstandard2.0，使 netstandard2.1 的客户端工程与 net10.0 的服务端工程都能引用。
    -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <RootNamespace>SamMeow.LLMTraderChat.Shared</RootNamespace>
    <AssemblyName>SamMeow.LLMTraderChat.Shared</AssemblyName>

    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

</Project>
