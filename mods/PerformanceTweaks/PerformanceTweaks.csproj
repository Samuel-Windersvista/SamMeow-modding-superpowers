<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      SPT 3.11.x (EFT 0.16) 客户端 mod。官方 spt-core 以 net471 为目标（见
      external/decompile-cache/spt-3.11.4-plugins/spt-core/spt-core.csproj），保持一致。
      BepInEx 5 / Unity Mono 运行时，勿改 net6+。
    -->
    <TargetFramework>net471</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <OutputType>Library</OutputType>
    <RootNamespace>SamMeow.SPT.PerformanceTweaks</RootNamespace>
    <AssemblyName>SamMeow.PerformanceTweaks</AssemblyName>
    <Version>0.3.0</Version>

    <!-- SPT 3.11.4 安装根目录（含 EscapeFromTarkov.exe）。可命令行覆盖：-p:SPTInstallPath="..." -->
    <SPTInstallPath Condition="'$(SPTInstallPath)' == ''">E:\Game\EFT_Offline\SPT_3114</SPTInstallPath>

    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(SPTInstallPath)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(SPTInstallPath)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- EFT 0.16 主程序集（混淆名版本，3.11 未反混淆），补丁目标类在这里 -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SPTInstallPath)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SPTInstallPath)\EscapeFromTarkov_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SPTInstallPath)\EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Comfort.Common（EFT 自带，提供 Singleton<T>，GameWorld 等全局单例访问） -->
    <Reference Include="Comfort">
      <HintPath>$(SPTInstallPath)\EscapeFromTarkov_Data\Managed\Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 构建后把 DLL 复制到 release/，方便直接拿取部署到 BepInEx/plugins/ -->
  <Target Name="CopyToRelease" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProjectDir)release" />
  </Target>

</Project>
