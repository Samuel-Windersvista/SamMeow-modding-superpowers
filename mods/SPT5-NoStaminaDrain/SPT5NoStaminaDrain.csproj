<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      SPT 5.0 / EFT 1.1.5 是 IL2CPP + BepInEx 6，插件必须面向 net6.0，
      并引用 BepInEx/interop/ 下的 Il2CppInterop 代理程序集（不是 EscapeFromTarkov_Data/Managed）。
      与 4.1（BepInEx 5 / Mono / netstandard2.1）完全不同，勿套用旧模板。
    -->
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Library</OutputType>
    <RootNamespace>SPT5NoStaminaDrain</RootNamespace>
    <AssemblyName>SPT5NoStaminaDrain</AssemblyName>
    <Version>1.0.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- SPT 5.0 客户端安装根（含 EscapeFromTarkov.exe）。
         SptRoot 由 mods/Directory.Build.props 集中提供；可覆盖：-p:SPT5Path=... 或 -p:SptRoot=... -->
    <SPT5Path Condition="'$(SPT5Path)' == ''">$(SptRoot)\SPT_5xx</SPT5Path>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>$(SPT5Path)\BepInEx\core\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(SPT5Path)\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(SPT5Path)\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(SPT5Path)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SPT5Path)\BepInEx\interop\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(SPT5Path)\BepInEx\interop\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
