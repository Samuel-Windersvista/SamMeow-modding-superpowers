<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      SPT 3.11.4 (EFT 0.16, Norvinsk Edition) 客户端 Harmony 护栏 mod。
      目标 Assembly-CSharp.dll 以 netstandard2.1 编译（ReflectionOnly 引用解析证实），
      BepInEx 5 / Unity Mono 运行时；模板参照 mods/PerformanceTweaks413。
      职责单一：boss 跟班 NRE / 滑步护栏（BotBoss / PatrolDataFollower / BotFollower）。
    -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <OutputType>Library</OutputType>
    <RootNamespace>SamMeow.SPT.FollowerGuard</RootNamespace>
    <AssemblyName>SamMeow.FollowerGuard</AssemblyName>
    <Version>0.1.1</Version>

    <!-- SPT 3.11.4 安装根目录（含 EscapeFromTarkov.exe）。
         SptRoot 由 mods/Directory.Build.props 集中提供；可覆盖：-p:SptRoot="..." -->
    <SPTInstallPath Condition="'$(SPTInstallPath)' == ''">$(SptRoot)\SPT_3114</SPTInstallPath>

    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(SPTInstallPath)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(SPTInstallPath)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- EFT 0.16 主程序集：BotBoss / PatrolDataFollower / BotFollower 等补丁目标 -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SPTInstallPath)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SPTInstallPath)\EscapeFromTarkov_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SPTInstallPath)\EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 构建后把 DLL 复制到 release/，方便直接拿取部署到 BepInEx/plugins/。
       验证脚本以 -p:SkipCopyToRelease=true 关闭本步骤，避免污染已入仓 DLL。 -->
  <Target Name="CopyToRelease" AfterTargets="Build" Condition="'$(SkipCopyToRelease)' != 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProjectDir)release" />
  </Target>

</Project>
