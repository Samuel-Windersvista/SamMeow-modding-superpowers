   "published_at": "2024-07-09T00:15:28.000000Z",
   "created_at": "2024-07-09T00:15:28.000000Z",
   "updated_at": "2026-05-14T03:54:46.000000Z",
   "dependencies": []
  },
  {
   "id": 3443,
   "hub_id": 10874,
   "version": "1.1.2",
   "description": "<ul>\n<li>Added new ammo, 6mm ARC, used in AR-15 platforms</li>\n<li>Updated all AR-15 magazines to include this ammo</li>\n<li>Made sure First Aid Pouch and Ammo Pouch could fit into secured containers without using SVM</li>\n<li>Balanced unlock loyalty levels for some items</li>\n</ul>\n<p><img loading=\"lazy\" decoding=\"async\" src=\"https://i.imgur.com/jIboD1R.png\" alt=\"jIboD1R.png\" /></p>\n<p>This release is only for SPT 3.9+</p>\n",
   "link": "https://sp-mod.com/mod/download/1125/tactical-gear-component/1.1.2",
   "content_length": null,
   "spt_version_constraint": "~3.9.0",
