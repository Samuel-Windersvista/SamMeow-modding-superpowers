   "hub_id": 8332,
   "version": "1.4.3",
   "description": "<p>Added support for side specific quests.</p>\n<p>Quests can have the “side” value set to either “Pmc”, “Bear” or “Usec”.</p>\n<p>EDIT: THIS FEATURE WILL CHANGE FOR 3.8.0, SEE MAIN PAGE.</p>\n<p>SPT-AKI 3.7.x</p>\n",
   "link": "https://sp-mod.com/mod/download/649/virtuals-custom-quest-loader/1.4.3",
   "content_length": null,
