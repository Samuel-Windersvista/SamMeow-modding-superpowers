      "checkable": true,
      "check": {
        "kind": "both",
        "handler": "no-files-by-extension",
        "params": {
          "extensions": [
            ".ts",
            ".js",
            ".tsx",
            ".jsx"
          ],
          "messages": {
            "detail": "forbidden JS/TS files: {count}"
          }
