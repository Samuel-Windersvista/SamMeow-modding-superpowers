<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RZCustomProfiles</AssemblyName>
    <RootNamespace>RZCustomProfiles</RootNamespace>
    <Version>1.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.2" />
    <PackageReference Include="SPTarkov.DI" Version="4.1.2" />
    <PackageReference Include="SemanticVersioning" Version="3.0.0" />
    <!-- 服务端运行时 0Harmony.dll = HarmonyX 2.16.1（SPT 4.1.2 SPT_Runtime 根目录） -->
    <PackageReference Include="HarmonyX" Version="2.16.1" />
  </ItemGroup>
</Project>
