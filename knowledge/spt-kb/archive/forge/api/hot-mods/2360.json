    "name":  "Server Tweaks - Discount SVM",
    "slug":  "server-tweaks-discount-svm",
    "teaser":  "A simple mod that contains some universal server config tweaks.",
    "thumbnail":  "https://forge-static.sp-tarkov.com/mods/7O1PVR4U1hjMuOVcdX8rd5DV7kGK2l0sZPpmeH4c.png",
