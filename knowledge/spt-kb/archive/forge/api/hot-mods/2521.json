    "name":  "Amands\u0027 Sense - Updated",
    "slug":  "amands-sense-updated",
    "teaser":  "Interactable icons for items, containers, bodies and extracts.",
    "thumbnail":  "https://forge-static.sp-tarkov.com/mods/9Wf52P2s2vmf2WRrkSl5ziP1b84VounUoLLX4nsg.png",
