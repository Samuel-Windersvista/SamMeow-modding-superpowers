.artifacts/*
!.artifacts/.gitkeep
.worktrees/
.playwright-mcp/
docs/initial_pormpt.md
docs/initial_pormpt.pdf

*.log
*.tmp
*.bak
Thumbs.db
Desktop.ini

/.external-resource

# Build output of scripts/build-portable-plugin.ps1 (portable plugin staging).
# Generated, not source — never tracked; rebuilt on demand.
/dist/

# .opencode/ holds dev memory + acceptance artifacts + legacy skill stash;
# ship only the OpenCode plugin code and the user-facing INSTALL.md.
/.opencode/*
!/.opencode/plugins/
!/.opencode/INSTALL.md

# AGENTS.md is now a tracked agent-skills config (see docs/agents/). The old
# gitignored dev-router role is retired with the SPT-only cleanup.

# Vendored / mirrored knowledge archives are reference material, not source.
# The curated index, guides, wiki snapshot, and sources stay tracked.
/knowledge/spt-kb/archive/

# Build artifacts — never source, never tracked, at any depth.
**/obj/
**/bin/

# Node dependency trees — installed per tool via `npm ci`, never tracked.
**/node_modules/

# Python dev artifacts (pytest / mypy / ruff) — apply at any depth.
**/__pycache__/
**/.mypy_cache/
**/.pytest_cache/
**/.ruff_cache/
**/*.egg-info/
*.pyc

# Superpowers skill auto-injected docs (not committed)
docs/superpowers/

# ILSpy decompilation cache (EFT/SPT assemblies). Derived, regenerable via
# ilspycmd -p --nested-directories -o <target> <dll>; too large to commit.
/external/decompile-cache/

# Vendored SPT archive mirror. The original lives outside the repo at
# E:\云文件\GitHub\SPT-archive\; nothing under here is source.
/external/spt-archive/

# External reference clones for the in-raid bridge work (ecosystem prior art:
# Web Minimap / bepinex-mcp). Local corpus, never source.
/external/references/

ModOrganizer-*.dmp
*.ala

# BEGIN oh-my-opencode-slim worktrees
.slim/worktrees/
.slim/worktrees.json
# END oh-my-opencode-slim worktrees

# tarkov-runtime-mcp ���� fixture ��־����⣨ticket 04��
!tools/tarkov-runtime-mcp/tests/fixtures/**/*.log
