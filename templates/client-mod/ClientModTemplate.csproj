<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      STD-BUILD-002：客户端 mod 必须使用与目标 SPT 版本运行时兼容的目标框架。
      4.1.5（Mono / BepInEx 5）：netstandard2.1（net472/net471 亦可），禁止 net10.0/net9.0 等 .NET Core/5+ 目标；
      5.0（IL2CPP / BepInEx 6）：net6.0。5.0 形态不在本模板内实现，参见 STD-BUILD-002 / STD-CLI-001。

      客户端 mod 在 Unity 的 Mono 运行时下加载，net10.0 程序集无法被 Mono 加载。
      SPT 4.1 官方客户端模块（external/spt-archive/modules）同样以 netstandard2.1 为目标。
      不要改成 net10.0，除非目标环境已是 BepInEx 6（.NET 6+）。
    -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <RootNamespace>{{ROOT_NAMESPACE}}</RootNamespace>
    <AssemblyName>{{MOD_CLASS_NAME}}</AssemblyName>
    <!-- STD-META-005：三段式 semver -->
    <Version>{{MOD_VERSION}}</Version>

    <!--
      STD-BUILD-006：SPT 客户端安装根目录（含 EscapeFromTarkov.exe 的目录）。
      用 Condition 提供可覆盖默认值，可在命令行覆盖：
        dotnet build -p:SPTInstallPath="D:\Games\SPT"
      禁止写成无法覆盖的硬编码。
    -->
    <SPTInstallPath Condition="'$(SPTInstallPath)' == ''">{{SPT_INSTALL_PATH}}</SPTInstallPath>

    <!-- STD-BUILD-005：输出路径不带框架名，方便把 DLL 复制到 BepInEx/plugins/ -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!--
      STD-BUILD-003：客户端运行时程序集（BepInEx / Harmony / Assembly-CSharp / UnityEngine）
      必须通过 <HintPath> 指向实际运行时 DLL，并设 <Private>false</Private>，不得复制进构建输出。
      5.0（IL2CPP / BepInEx 6）引用路径不同：core 在 $(SPT5Path)\BepInEx\core\，
      游戏程序集在 $(SPT5Path)\BepInEx\interop\（Il2CppInterop 代理），同样设 Private=false。
    -->
    <!-- BepInEx 5 核心（BepInEx/plugins/ 下的插件由它加载） -->
    <Reference Include="BepInEx">
      <HintPath>$(SPTInstallPath)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Harmony 2.x（补丁库） -->
    <Reference Include="0Harmony">
      <HintPath>$(SPTInstallPath)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 游戏主程序集（4.1 已反混淆，类型有真名真命名空间），补丁目标类在这里 -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SPTInstallPath)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- MonoBehaviour 基类所在（BaseUnityPlugin 继承它），必须引用 -->
    <Reference Include="UnityEngine">
      <HintPath>$(SPTInstallPath)\EscapeFromTarkov_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SPTInstallPath)\EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 如需 UnityEngine.UI / EventSystems 等，按需补充 UnityEngine.UI.dll / UnityEngine.UIModule.dll -->
  </ItemGroup>

</Project>
