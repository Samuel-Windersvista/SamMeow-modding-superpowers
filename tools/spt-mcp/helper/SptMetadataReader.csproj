<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>spt-metadata-reader</AssemblyName>
    <RootNamespace>SptMetadataReader</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- 本地 AsmResolver 缓存：从 SPT_Runtime 拷贝，避免构建时依赖游戏路径 -->
    <AsmResolverDir>$(MSBuildThisFileDirectory)lib\</AsmResolverDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="AsmResolver">
      <HintPath>$(AsmResolverDir)AsmResolver.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="AsmResolver.PE">
      <HintPath>$(AsmResolverDir)AsmResolver.PE.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="AsmResolver.PE.File">
      <HintPath>$(AsmResolverDir)AsmResolver.PE.File.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="AsmResolver.DotNet">
      <HintPath>$(AsmResolverDir)AsmResolver.DotNet.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
