<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>SkillsExtended</RootNamespace>
    <AssemblyName>SkillsExtended</AssemblyName>
    <Version>1.6.0</Version>

    <!-- SptRoot 由 tools/migration-pilots/Directory.Build.props 集中提供；可覆盖：-p:SPTInstallPath=... 或 -p:SptRoot=... -->
    <SPTInstallPath Condition="'$(SPTInstallPath)' == ''">$(SptRoot)\SPT_41x\SPT_Runtime</SPTInstallPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- 服务端工程仅编译 src/**；client-src 由 SkillsExtendedClient.csproj 独立编译。
         C9 复验修复：默认 glob 曾把 net472 客户端源码扫入 net10.0 服务端编译（534 错）。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);client-src\**;bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="SPTarkov.Server.Core">
      <HintPath>$(SPTInstallPath)\SPTarkov.Server.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <HintPath>$(SPTInstallPath)\SPTarkov.DI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Common">
      <HintPath>$(SPTInstallPath)\SPTarkov.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SemanticVersioning">
      <HintPath>$(SPTInstallPath)\SemanticVersioning.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- 数据文件随 mod 打包 -->
    <None Include="bundles\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="bundles.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="config\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="data\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
