    {
      "path": "tools/tarkov-active-probe/src/ModMetadata.cs",
      "kind": "code",
      "pattern": "Version Version \\{ get; init; \\} = new\\(\"([^\"]+)\"\\)"
    },
    {
      "path": "tools/spt-mcp/src/index.ts",
      "kind": "code",
      "pattern": "SERVER_VERSION\\s*=\\s*\"([^\"]+)\""
    },
    {
      "path": "tools/mo2-mcp/src/index.ts",
      "kind": "code",
      "pattern": "SERVER_VERSION\\s*=\\s*\"([^\"]+)\""
    },
    {
      "path": "tools/tarkov-runtime-mcp/src/index.ts",
      "kind": "code",
      "pattern": "SERVER_VERSION\\s*=\\s*\"([^\"]+)\""
    }
  ],
  "audit": {
    "exclude": [
      "RELEASE-NOTES.md",
      "CHANGELOG.md",
