{
  "source": { "path": "package.json", "field": "version" },
  "files": [
    { "path": "tools/mcp-kit/package.json", "kind": "json", "field": "version" },
    { "path": "tools/mcp-kit/package-lock.json", "kind": "npm-lock" },
